# Copy to .env and fill in. Never commit .env.

# Image tag used by docker-compose.vps.yml. "main" follows every push to main.
# Before MODE=testnet or live, pin a tested commit: IMAGE_TAG=<full git sha> (CI pushes
# ghcr.io/aliercankonus/dailybot:<sha> for every main commit), so an update never pulls untested code.
IMAGE_TAG=main
# Set to 1 to run the one-shot research (download + backtest) job on the next project update.
RESEARCH=0

# paper   = live public market data, simulated account (no API key needed)
# testnet = Binance futures demo/testnet account
# live    = REAL MONEY. Also requires CONFIRM_LIVE=I_UNDERSTAND_REAL_MONEY
MODE=paper
CONFIRM_LIVE=

# Futures API key: enable "Futures" only. NEVER enable withdrawals. Restrict to the VPS IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Override only if Binance changes hosts. Defaults: live https://fapi.binance.com, testnet https://demo-fapi.binance.com
BINANCE_BASE_URL=
# Conditional (stop) order API: "auto" (detect), "algo" (new Algo Order API) or "legacy" (/fapi/v1/order). Verify on testnet.
BINANCE_STOP_API=auto

SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
# trend (A, 4h) | pullback (B, 1h) | meanrev (C, 1h). The strategy sets the candle interval.
STRATEGY=trend
RISK_PER_TRADE=0.005
MAX_LEVERAGE=3
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT=0.03
MAX_DRAWDOWN=0.15
PAPER_START_BALANCE=10000
# Bounds: TAKER_FEE <= 0.01, SLIPPAGE <= 0.05, TICK_SECONDS >= 15
TAKER_FEE=0.0005
SLIPPAGE=0.0005
TICK_SECONDS=60

POSTGRES_PASSWORD=change-me-long-random
API_PORT=8080
# openssl rand -hex 32
API_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
