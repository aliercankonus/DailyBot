{
  "name": "trading-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "download": "tsx src/cli/download.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "engine": "tsx src/cli/engine.ts",
    "start:engine": "node dist/cli/engine.js",
    "start:api": "node dist/cli/api.js",
    "api": "tsx src/cli/api.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
